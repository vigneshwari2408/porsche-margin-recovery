	/// QA reference: values exactly as published by the SQL mart views, with tolerance = view rounding. Disconnected; used by the QA page.
	table RefSQL

		/// Value published by the SQL mart view for this row.
		measure 'QA SQL Value' = IF ( HASONEVALUE ( RefSQL[metric_key] ), SUM ( RefSQL[sql_value] ) )
			formatString: 0.000000
			displayFolder: 12 QA vs SQL

		/// The same quantity recomputed by the Power BI measures (from base values, not from the SQL result).
		measure 'QA DAX Value' =
				VAR _k = SELECTEDVALUE ( RefSQL[metric_key] )
				VAR _p = SELECTEDVALUE ( RefSQL[period_code] )
				VAR _s = SELECTEDVALUE ( RefSQL[scenario_id] )
				RETURN
					SWITCH ( TRUE (),
						LEFT ( _k, 3 ) = "gs_",
							CALCULATE ( SWITCH ( _k,
							"gs_l0_min", [Scen Min Margin L0] * 100,
							"gs_l0_mid", [Scen Mid Margin L0] * 100,
							"gs_l0_max", [Scen Max Margin L0] * 100,
							"gs_l1_min", [Scen Min Margin L1] * 100,
							"gs_l1_mid", [Scen Mid Margin L1] * 100,
							"gs_l1_max", [Scen Max Margin L1] * 100,
							"gs_l2_min", [Scen Min Margin L2] * 100,
							"gs_l2_mid", [Scen Mid Margin L2] * 100,
							"gs_l2_max", [Scen Max Margin L2] * 100 ) ),
						LEFT ( _k, 2 ) = "g_",
							CALCULATE ( SWITCH ( _k,
							"g_h2_margin_l0_pct", [Scen H2 Margin L0 (DAX recompute)] * 100,
							"g_h2_margin_l1_pct", [Scen H2 Margin L1 (DAX recompute)] * 100,
							"g_h2_margin_l2_pct", [Scen H2 Margin L2 (DAX recompute)] * 100 ), TREATAS ( { _s }, FactGuidance[scenario_id] ) ),
						_k = "mix_share_pct",
							CALCULATE ( [Mix Share] * 100, REMOVEFILTERS ( DimPeriod ), TREATAS ( { _p }, DimPeriod[period_code] ),
								TREATAS ( { SELECTEDVALUE ( RefSQL[dimension] ) }, FactDeliveryMix[dimension] ),
								TREATAS ( { SELECTEDVALUE ( RefSQL[member_id] ) }, FactDeliveryMix[member_id] ) ),
						LEFT ( _k, 3 ) = "ga_",
							CALCULATE ( SWITCH ( _k,
							"ga_h2_ebitda_margin_pct", [Scen Auto H2 EBITDA Margin (DAX recompute)] * 100,
							"ga_h2_ncf_margin_pct", [Scen Auto H2 NCF Margin (DAX recompute)] * 100 ), TREATAS ( { _s }, FactGuidanceAuto[scenario_id] ) ),
						CALCULATE ( SWITCH ( _k,
							"ebit_l0_reported", [EBIT L0 Reported],
							"ebit_l1_ex_realignment", [EBIT L1],
							"ebit_l2_ex_realignment_tariffs", [EBIT L2],
							"ebit_l3_hybrid_sensitivity", [EBIT L3 Hybrid Sensitivity],
							"margin_l0_reported_pct", [Margin L0] * 100,
							"margin_l1_pct", [Margin L1] * 100,
							"margin_l2_pct", [Margin L2] * 100,
							"margin_l3_hybrid_pct", [Margin L3 Hybrid Sensitivity] * 100,
							"yoy_ebit_l1", [YoY EBIT L1],
							"yoy_margin_l1_pp", [YoY Margin L1 (pp)],
							"yoy_margin_l0_pp", [YoY Margin L0 (pp)],
							"da_clean", [Clean DA],
							"yoy_da_clean", [YoY Clean DA],
							"rd_total_costs", [RD Total Costs],
							"rd_pl_charge", [RD PL Charge],
							"cap_rate_calc_pct", [Cap Rate Calc] * 100,
							"net_capitalisation", [Net Capitalisation],
							"ebit_effect_of_cap_rate_change", [Cap Rate Effect (DAX recompute)],
							"yoy_rd_pl_charge", [YoY RD PL Charge],
							"asp_calc_eur_k", [ASP (EUR k)],
							"yoy_vehicle_sales_pct", [YoY Vehicle Sales %] * 100,
							"yoy_asp_pct", [YoY ASP %] * 100,
							"yoy_auto_revenue", [YoY Auto Revenue],
							"volume_effect", [Volume Effect (DAX recompute)],
							"asp_effect", [ASP Effect (DAX recompute)],
							"auto_net_cash_flow", [Auto NCF],
							"ncf_margin_pct", [NCF Margin] * 100,
							"ebitda_margin_calc_pct", [EBITDA Margin] * 100,
							"cfo_to_ebitda", [CFO to EBITDA],
							"simple_cash_proxy", [Simple Cash Proxy],
							"d_ebit", [YoY EBIT L0],
							"eff_residual_other_drivers", [Recompute Residual],
							"d_margin_pp", [YoY Margin L0 (pp)] ), REMOVEFILTERS ( DimPeriod ), TREATAS ( { _p }, DimPeriod[period_code] ) )
					)
			formatString: 0.000000
			displayFolder: 12 QA vs SQL

		/// |DAX - SQL|.
		measure 'QA Abs Difference' = ABS ( [QA DAX Value] - [QA SQL Value] )
			formatString: 0.000000
			displayFolder: 12 QA vs SQL

		/// PASS within the SQL view's rounding tolerance.
		measure 'QA Status' = IF ( ISBLANK ( [QA DAX Value] ), "MISSING", IF ( [QA Abs Difference] <= SELECTEDVALUE ( RefSQL[tolerance] ), "PASS", "FAIL" ) )
			displayFolder: 12 QA vs SQL

		/// Rows not passing.
		measure 'QA Fail Count' = SUMX ( RefSQL, IF ( [QA Status] = "PASS", 0, 1 ) )
			formatString: 0
			displayFolder: 12 QA vs SQL

		/// Model status card.
		measure 'QA Summary' = VAR _n = COUNTROWS ( RefSQL ) VAR _f = [QA Fail Count] RETURN IF ( _f = 0, "ALL " & _n & " QA CHECKS PASS (Power BI vs SQL mart)", _f & " OF " & _n & " QA CHECKS FAIL - see QA page" )
			displayFolder: 12 QA vs SQL

		/// Largest EUR/unit identity breach across periods (bridge closure, mix total). Must be 0.
		measure 'QA Identity Checks Max' =
				ROUND (
					MAXX (
						VALUES ( DimPeriod[period_code] ),
						MAX ( ABS ( [Bridge Closure Check] ), ABS ( [Mix Total Check] ) )
					),
					10
				)
			formatString: 0.000000
			displayFolder: 12 QA vs SQL

		column metric_key
			dataType: string
			sourceColumn: metric_key

		column period_code
			dataType: string
			sourceColumn: period_code

		column scenario_id
			dataType: string
			sourceColumn: scenario_id

		column sql_value
			dataType: double
			summarizeBy: none
			formatString: #,##0.00
			sourceColumn: sql_value

		column tolerance
			dataType: double
			summarizeBy: none
			formatString: 0.000
			sourceColumn: tolerance

		column sql_view
			dataType: string
			sourceColumn: sql_view

		column dimension
			dataType: string
			sourceColumn: dimension

		column member_id
			dataType: string
			sourceColumn: member_id

		partition RefSQL = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "RefSQL.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"metric_key", type text}, {"period_code", type text}, {"scenario_id", type text}, {"sql_value", type number}, {"tolerance", type number}, {"sql_view", type text}, {"dimension", type text}, {"member_id", type text}}, "en-US")
					in
						Typed

	relationship FactHalfYear_period_code_DimPeriod
		fromColumn: FactHalfYear.period_code
		toColumn: DimPeriod.period_code

	relationship FactBridgeYoY_period_code_DimPeriod
		fromColumn: FactBridgeYoY.period_code
		toColumn: DimPeriod.period_code

	relationship FactBridgeYoY_step_id_DimBridgeStep
		fromColumn: FactBridgeYoY.step_id
		toColumn: DimBridgeStep.step_id

	relationship FactSensitivity_period_code_DimPeriod
		fromColumn: FactSensitivity.period_code
		toColumn: DimPeriod.period_code

	relationship FactDeliveryMix_period_code_DimPeriod
		fromColumn: FactDeliveryMix.period_code
		toColumn: DimPeriod.period_code

	relationship FactLineage_period_code_DimPeriod
		fromColumn: FactLineage.period_code
		toColumn: DimPeriod.period_code

	relationship FactLineage_source_id_DimSource
		fromColumn: FactLineage.source_id
		toColumn: DimSource.source_id

	relationship Annotation_period_code_DimPeriod
		fromColumn: Annotation.period_code
		toColumn: DimPeriod.period_code
