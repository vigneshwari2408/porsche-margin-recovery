		partition FactHalfYear = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "FactHalfYear.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"period_code", type text}, {"grp_revenue", type number}, {"grp_ebit", type number}, {"adj_realignment_net", type number}, {"adj_us_tariffs", type number}, {"rounding_band_eur_m", type number}, {"ebit_assumptions_used", type text}, {"exc_battery_memo", type number}, {"auto_revenue", type number}, {"auto_ebit", type number}, {"auto_ebitda", type number}, {"auto_ebitda_margin_published", type number}, {"rd_total", type number}, {"rd_capitalised", type number}, {"rd_expensed", type number}, {"amort_capitalised_rd", type number}, {"rd_cap_rate_published", type number}, {"sql_ebit_effect_of_cap_rate_change", type number}, {"sql_rd_pl_at_prior_cap_rate", type number}, {"capex", type number}, {"dep_on_capex", type number}, {"da_total", type number}, {"impairment_used", type number}, {"impairment_status", type text}, {"fs_revenue", type number}, {"fs_ebit", type number}, {"auto_cfo", type number}, {"auto_cfi_operating", type number}, {"auto_net_cash_flow", type number}, {"auto_net_liquidity", type number}, {"cash_notes", type text}, {"deliveries", type number}, {"vehicle_sales", type number}, {"asp_published_eur_k", type number}, {"bev_share_published", type number}, {"sql_volume_effect", type number}, {"sql_asp_effect", type number}, {"bridge_gross_margin_ex_rd", type number}, {"bridge_rd", type number}, {"bridge_sga", type number}, {"bridge_other", type number}, {"bridge_extraordinary_memo", type number}}, "en-US")
					in
						Typed

	/// mart.v_ebit_bridge_yoy in long form: EUR m and margin-point effects per bridge step.
	table FactBridgeYoY

		/// SQL bridge value per step (mart.v_ebit_bridge_yoy). Use with DimBridgeStep[step_name] in a waterfall.
		measure 'Bridge EUR m' = SUM ( FactBridgeYoY[eur_m] )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL margin-point bridge per step; includes the revenue-denominator step; sums to the change in reported margin.
		measure 'Bridge pp' = SUM ( FactBridgeYoY[pp] )
			formatString: +0.00;-0.00;0.00
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL bridge step S0_START.
		measure 'Bridge Start EBIT' = CALCULATE ( [Bridge EUR m], DimBridgeStep[step_id] = "S0_START" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL bridge step S1_EXC.
		measure 'Bridge Exceptional' = CALCULATE ( [Bridge EUR m], DimBridgeStep[step_id] = "S1_EXC" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL bridge step S2_TAR.
		measure 'Bridge Tariffs' = CALCULATE ( [Bridge EUR m], DimBridgeStep[step_id] = "S2_TAR" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL bridge step S3_CAPDEV.
		measure 'Bridge Cap Dev' = CALCULATE ( [Bridge EUR m], DimBridgeStep[step_id] = "S3_CAPDEV" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL bridge step S4_DA.
		measure 'Bridge Clean DA' = CALCULATE ( [Bridge EUR m], DimBridgeStep[step_id] = "S4_DA" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL bridge step S5_FS.
		measure 'Bridge FS' = CALCULATE ( [Bridge EUR m], DimBridgeStep[step_id] = "S5_FS" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// SQL bridge step S6_RES.
		measure 'Bridge Residual' = CALCULATE ( [Bridge EUR m], DimBridgeStep[step_id] = "S6_RES" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// Residual / other EBIT drivers in margin points.
		measure 'Bridge Residual pp' = CALCULATE ( [Bridge pp], DimBridgeStep[step_id] = "S6_RES" )
			formatString: +0.00;-0.00;0.00
			displayFolder: 04 EBIT bridge (SQL)

		/// Residual if the H1 2026 impairments are NOT inside D&A (A-04 false). Sensitivity only.
		measure 'Bridge Residual alt A-04' = CALCULATE ( SUM ( FactSensitivity[value_eur_m] ), FactSensitivity[sensitivity_id] = "SENS_A04_RES" )
			formatString: +#,##0;-#,##0;0
			displayFolder: 04 EBIT bridge (SQL)

		/// Sum of all bridge effects = change in reported EBIT.
		measure 'Bridge Components Total' = CALCULATE ( [Bridge EUR m], REMOVEFILTERS ( DimBridgeStep ), DimBridgeStep[step_id] <> "S0_START" )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// Lower disclosed one-offs as a share of the reported EBIT change. >100% = the whole reported gain (and more) comes from lower one-offs.
		measure 'One-offs Share of EBIT Change' = DIVIDE ( [Bridge Exceptional] + [Bridge Tariffs], [YoY EBIT L0] )
			formatString: 0%
			displayFolder: 04 EBIT bridge (SQL)

		/// QA: SQL bridge components - DAX change in reported EBIT. Must be 0.
		measure 'Bridge Closure Check' = [Bridge Components Total] - [YoY EBIT L0]
			formatString: 0.000000
			displayFolder: 04 EBIT bridge (SQL)

		/// QA: SQL pp bridge - DAX change in reported margin. Within 0.005 (3-dp rounding in SQL).
		measure 'Bridge pp Closure Check' = ROUND ( CALCULATE ( [Bridge pp], REMOVEFILTERS ( DimBridgeStep ) ) - [YoY Margin L0 (pp)], 4 )
			formatString: 0.0000
			displayFolder: 04 EBIT bridge (SQL)

		column period_code
			dataType: string
			sourceColumn: period_code

		column prior_period_code
			dataType: string
			sourceColumn: prior_period_code

		column step_id
			dataType: string
			sourceColumn: step_id

		column eur_m
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: eur_m

		column pp
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: pp

		partition FactBridgeYoY = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "FactBridgeYoY.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"period_code", type text}, {"prior_period_code", type text}, {"step_id", type text}, {"eur_m", type number}, {"pp", type number}}, "en-US")
					in
						Typed

	/// Assumption-driven alternatives (A-04). Sensitivity only - never headline.
	table FactSensitivity

		column period_code
			dataType: string
			sourceColumn: period_code

		column sensitivity_id
			dataType: string
			sourceColumn: sensitivity_id

		column description
			dataType: string
			sourceColumn: description

		column assumption_id
			dataType: string
			sourceColumn: assumption_id

		column value_eur_m
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: value_eur_m

		partition FactSensitivity = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "FactSensitivity.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"period_code", type text}, {"sensitivity_id", type text}, {"description", type text}, {"assumption_id", type text}, {"value_eur_m", type number}}, "en-US")
					in
						Typed

	/// mart.v_delivery_mix: retail deliveries by model line (Macan total) and by region.
	table FactDeliveryMix

		/// Retail deliveries by model line / region. Always filter FactDeliveryMix[dimension] to one value.
		measure 'Mix Deliveries' = SUM ( FactDeliveryMix[deliveries] )
			formatString: #,##0
			displayFolder: 06 Commercial

		/// Share of deliveries within the selected dimension and period (removes only the member filters; the period filter from DimPeriod is kept).
		measure 'Mix Share' = DIVIDE ( [Mix Deliveries], CALCULATE ( [Mix Deliveries], REMOVEFILTERS ( FactDeliveryMix[member_id], FactDeliveryMix[member_name], FactDeliveryMix[member_sort] ) ) )
			formatString: 0.0%
			displayFolder: 06 Commercial

		/// Mix share in the same half of the prior year.
		measure 'Mix Share PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Mix Share], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: 0.0%
			displayFolder: 06 Commercial

		/// Change in delivery share, pp.
		measure 'Mix Share Change (pp)' = IF ( NOT ISBLANK ( [Mix Share PY] ), ( [Mix Share] - [Mix Share PY] ) * 100 )
			formatString: +0.00;-0.00;0.00
			displayFolder: 06 Commercial

		/// QA: model-line deliveries - total deliveries. Must be 0.
		measure 'Mix Total Check' = CALCULATE ( [Mix Deliveries], FactDeliveryMix[dimension] = "model" ) - [Retail Deliveries]
			formatString: #,##0
			displayFolder: 11 QA recompute

		column period_code
			dataType: string
			sourceColumn: period_code

		column dimension
			dataType: string
			sourceColumn: dimension

		column member_id
			dataType: string
			sourceColumn: member_id

		column member_name
			dataType: string
			sortByColumn: member_sort
			sourceColumn: member_name

		column deliveries
			dataType: int64
			summarizeBy: none
			isHidden
			sourceColumn: deliveries

		column share_pct
			dataType: double
			summarizeBy: none
			isHidden
			formatString: 0.00
			sourceColumn: share_pct

		column value_label
			dataType: string
			sourceColumn: value_label

		column member_sort
			dataType: int64
			summarizeBy: none
			isHidden
			sourceColumn: member_sort

		partition FactDeliveryMix = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "FactDeliveryMix.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"period_code", type text}, {"dimension", type text}, {"member_id", type text}, {"member_name", type text}, {"deliveries", Int64.Type}, {"share_pct", type number}, {"value_label", type text}, {"member_sort", Int64.Type}}, "en-US")
					in
						Typed

	/// mart.v_guidance_2026: 27 SCENARIO COMBINATIONS of FY2026 guidance range ends. NOT forecasts, NO probabilities.
	table FactGuidance

		/// Fixed disclaimer for every scenario visual.
		measure 'Scenario Disclaimer' = "SCENARIO COMBINATIONS OF PORSCHE FY2026 GUIDANCE RANGE ENDS - ARITHMETIC ONLY - NOT FORECASTS - NO PROBABILITIES"
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Number of combinations in context (1 = one combination selected).
		measure 'Scen Rows Selected' = COUNTROWS ( FactGuidance )
			formatString: 0
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Describes the selected combination.
		measure 'Scen Selected Label' = IF ( COUNTROWS ( FactGuidance ) = 1, "Selected combination: " & SELECTEDVALUE ( FactGuidance[scenario_id] ) & " (revenue / RoS / extraordinary end)", "Select one end for revenue, RoS and extraordinary expenses" )
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 L0 margin implied by the selected combination (SQL v_guidance_2026). Arithmetic, not a forecast.
		measure 'Scen H2 Margin L0' = IF ( COUNTROWS ( FactGuidance ) = 1, SUM ( FactGuidance[h2_margin_l0_pct] ) / 100 )
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Lowest H2 2026 L0 margin across the 27 combinations.
		measure 'Scen Min Margin L0' = CALCULATE ( MIN ( FactGuidance[h2_margin_l0_pct] ), REMOVEFILTERS ( FactGuidance ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 L0 margin when ALL guidance midpoints are combined (not a most-likely case).
		measure 'Scen Mid Margin L0' = CALCULATE ( SUM ( FactGuidance[h2_margin_l0_pct] ), REMOVEFILTERS ( FactGuidance ), FactGuidance[scenario_id] = "mid/mid/mid" ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Highest H2 2026 L0 margin across the 27 combinations.
		measure 'Scen Max Margin L0' = CALCULATE ( MAX ( FactGuidance[h2_margin_l0_pct] ), REMOVEFILTERS ( FactGuidance ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 L1 margin implied by the selected combination (SQL v_guidance_2026). Arithmetic, not a forecast.
		measure 'Scen H2 Margin L1' = IF ( COUNTROWS ( FactGuidance ) = 1, SUM ( FactGuidance[h2_margin_l1_pct] ) / 100 )
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Lowest H2 2026 L1 margin across the 27 combinations.
		measure 'Scen Min Margin L1' = CALCULATE ( MIN ( FactGuidance[h2_margin_l1_pct] ), REMOVEFILTERS ( FactGuidance ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 L1 margin when ALL guidance midpoints are combined (not a most-likely case).
		measure 'Scen Mid Margin L1' = CALCULATE ( SUM ( FactGuidance[h2_margin_l1_pct] ), REMOVEFILTERS ( FactGuidance ), FactGuidance[scenario_id] = "mid/mid/mid" ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Highest H2 2026 L1 margin across the 27 combinations.
		measure 'Scen Max Margin L1' = CALCULATE ( MAX ( FactGuidance[h2_margin_l1_pct] ), REMOVEFILTERS ( FactGuidance ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 L2 margin implied by the selected combination (SQL v_guidance_2026). Arithmetic, not a forecast.
		measure 'Scen H2 Margin L2' = IF ( COUNTROWS ( FactGuidance ) = 1, SUM ( FactGuidance[h2_margin_l2_pct] ) / 100 )
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Lowest H2 2026 L2 margin across the 27 combinations.
		measure 'Scen Min Margin L2' = CALCULATE ( MIN ( FactGuidance[h2_margin_l2_pct] ), REMOVEFILTERS ( FactGuidance ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 L2 margin when ALL guidance midpoints are combined (not a most-likely case).
		measure 'Scen Mid Margin L2' = CALCULATE ( SUM ( FactGuidance[h2_margin_l2_pct] ), REMOVEFILTERS ( FactGuidance ), FactGuidance[scenario_id] = "mid/mid/mid" ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Highest H2 2026 L2 margin across the 27 combinations.
		measure 'Scen Max Margin L2' = CALCULATE ( MAX ( FactGuidance[h2_margin_l2_pct] ), REMOVEFILTERS ( FactGuidance ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 revenue implied (FY guidance end - H1 2026 actual).
		measure 'Scen H2 Revenue' = IF ( COUNTROWS ( FactGuidance ) = 1, SUM ( FactGuidance[h2_rev] ) )
			formatString: #,##0
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 reported EBIT implied.
		measure 'Scen H2 EBIT L0' = IF ( COUNTROWS ( FactGuidance ) = 1, SUM ( FactGuidance[h2_ebit_l0] ) )
			formatString: #,##0
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 L1 EBIT implied (A-06: extraordinary guidance is net).
		measure 'Scen H2 EBIT L1' = IF ( COUNTROWS ( FactGuidance ) = 1, SUM ( FactGuidance[h2_ebit_l1] ) )
			formatString: #,##0
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Selected combination's H2 L1 margin minus the latest actual H1 L1 margin, pp. Arithmetic gap, not a forecast.
		measure 'Scen H2 L1 vs Latest H1 (pp)' = ( [Scen H2 Margin L1] - [Latest Margin L1] ) * 100
			formatString: +0.00;-0.00;0.00
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// All-midpoints H2 L1 margin minus latest H1 L1 margin, pp.
		measure 'Scen Mid L1 vs Latest H1 (pp)' = ( [Scen Mid Margin L1] - [Latest Margin L1] ) * 100
			formatString: +0.00;-0.00;0.00
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// DAX recomputation of the H2 L0 margin from guidance inputs and H1 actuals (QA).
		measure 'Scen H2 Margin L0 (DAX recompute)' =
				VAR _r = SELECTEDVALUE ( FactGuidance[fy_rev] )
				VAR _ros = SELECTEDVALUE ( FactGuidance[fy_ros] )
				RETURN
					IF ( COUNTROWS ( FactGuidance ) = 1, DIVIDE ( _r * _ros / 100 - [Latest EBIT L0], _r - [Latest Revenue] ) )
			formatString: 0.00%
			displayFolder: 11 QA recompute

		/// DAX recomputation (QA).
		measure 'Scen H2 Margin L1 (DAX recompute)' =
				VAR _r = SELECTEDVALUE ( FactGuidance[fy_rev] )
				VAR _ros = SELECTEDVALUE ( FactGuidance[fy_ros] )
				VAR _exc = SELECTEDVALUE ( FactGuidance[fy_exc] )
				RETURN
					IF ( COUNTROWS ( FactGuidance ) = 1, DIVIDE ( _r * _ros / 100 - [Latest EBIT L0] + _exc - [Latest Adj Realignment], _r - [Latest Revenue] ) )
			formatString: 0.00%
			displayFolder: 11 QA recompute

		/// DAX recomputation (QA; A-07: H2 tariffs = H1).
		measure 'Scen H2 Margin L2 (DAX recompute)' =
				VAR _r = SELECTEDVALUE ( FactGuidance[fy_rev] )
				VAR _ros = SELECTEDVALUE ( FactGuidance[fy_ros] )
				VAR _exc = SELECTEDVALUE ( FactGuidance[fy_exc] )
				RETURN
					IF ( COUNTROWS ( FactGuidance ) = 1, DIVIDE ( _r * _ros / 100 - [Latest EBIT L0] + _exc - [Latest Adj Realignment] + [Latest Adj Tariffs], _r - [Latest Revenue] ) )
			formatString: 0.00%
			displayFolder: 11 QA recompute

		/// What the guidance requires from H2 relative to the latest actual half-year.
		measure 'Signal Guidance Gap' =
				VAR _mid = [Scen Mid Margin L1]
				VAR _h1 = [Latest Margin L1]
				RETURN
					"All-midpoint guidance combination implies an H2 L1 margin of " & FORMAT ( _mid, "0.0%" ) & " vs " & FORMAT ( _h1, "0.0%" ) & " in " & [Latest Period Label]
						& " (" & FORMAT ( ( _mid - _h1 ) * 100, "+0.0;-0.0" ) & " pp) - arithmetic, not a forecast" 
			displayFolder: 10 Recovery signals

		/// Min of the H2 2026 implied margin across the 27 combinations, for the level on the axis (L0-L2 only; no L3 scenario exists).
		measure 'Scen Min by Level' =
				SWITCH ( SELECTEDVALUE ( DimLevel[level_id] ),
					"L0", [Scen Min Margin L0],
					"L1", [Scen Min Margin L1],
					"L2", [Scen Min Margin L2] )
			formatString: 0.00%
			displayFolder: 13 Level-driven (legend = DimLevel)

		/// Mid of the H2 2026 implied margin across the 27 combinations, for the level on the axis (L0-L2 only; no L3 scenario exists).
		measure 'Scen Mid by Level' =
				SWITCH ( SELECTEDVALUE ( DimLevel[level_id] ),
					"L0", [Scen Mid Margin L0],
					"L1", [Scen Mid Margin L1],
					"L2", [Scen Mid Margin L2] )
			formatString: 0.00%
			displayFolder: 13 Level-driven (legend = DimLevel)

		/// Max of the H2 2026 implied margin across the 27 combinations, for the level on the axis (L0-L2 only; no L3 scenario exists).
		measure 'Scen Max by Level' =
				SWITCH ( SELECTEDVALUE ( DimLevel[level_id] ),
					"L0", [Scen Max Margin L0],
					"L1", [Scen Max Margin L1],
					"L2", [Scen Max Margin L2] )
			formatString: 0.00%
			displayFolder: 13 Level-driven (legend = DimLevel)

		column scenario_id
			dataType: string
			sourceColumn: scenario_id

		column scenario_type
			dataType: string
			sourceColumn: scenario_type

		column case_rev
			dataType: string
			sortByColumn: sort_rev
			sourceColumn: case_rev

		column case_ros
			dataType: string
			sortByColumn: sort_ros
			sourceColumn: case_ros

		column case_ex
			dataType: string
			sortByColumn: sort_ex
			sourceColumn: case_ex

		column sort_rev
			dataType: int64
			summarizeBy: none
			isHidden
			sourceColumn: sort_rev

		column sort_ros
			dataType: int64
			summarizeBy: none
			isHidden
			sourceColumn: sort_ros

		column sort_ex
			dataType: int64
			summarizeBy: none
			isHidden
			sourceColumn: sort_ex

		column fy_rev
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: fy_rev

		column fy_ros
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: fy_ros

		column fy_exc
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: fy_exc

		column fy_ebit
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: fy_ebit

		column h1_rev
