createOrReplace

	expression DataFolder = "C:\PCL\pcl_powerbi\data\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	/// Half-year periods 2023-H1..2026-H1 (analysis grain). prior_same_half_code drives all YoY measures.
	table DimPeriod

		column period_code
			dataType: string
			sourceColumn: period_code

		column period_label
			dataType: string
			sortByColumn: sort_key
			sourceColumn: period_label

		column sort_key
			dataType: int64
			summarizeBy: none
			isHidden
			sourceColumn: sort_key

		column fiscal_year
			dataType: int64
			summarizeBy: none
			sourceColumn: fiscal_year

		column half_no
			dataType: int64
			summarizeBy: none
			sourceColumn: half_no

		column half_label
			dataType: string
			sourceColumn: half_label

		column prior_same_half_code
			dataType: string
			sourceColumn: prior_same_half_code

		column has_prior_in_window
			dataType: boolean
			sourceColumn: has_prior_in_window

		column is_latest
			dataType: boolean
			sourceColumn: is_latest

		column n_fact_values
			dataType: int64
			summarizeBy: none
			sourceColumn: n_fact_values

		column n_derived_values
			dataType: int64
			summarizeBy: none
			sourceColumn: n_derived_values

		column derived_var_ids
			dataType: string
			sourceColumn: derived_var_ids

		column period_basis
			dataType: string
			sourceColumn: period_basis

		partition DimPeriod = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "DimPeriod.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"period_code", type text}, {"period_label", type text}, {"sort_key", Int64.Type}, {"fiscal_year", Int64.Type}, {"half_no", Int64.Type}, {"half_label", type text}, {"prior_same_half_code", type text}, {"has_prior_in_window", type logical}, {"is_latest", type logical}, {"n_fact_values", Int64.Type}, {"n_derived_values", Int64.Type}, {"derived_var_ids", type text}, {"period_basis", type text}}, "en-US")
					in
						Typed

	/// EBIT level legend: L0 reported, L1/L2 adjusted headline, L3 supplementary hybrid sensitivity (never headline).
	table DimLevel

		column level_id
			dataType: string
			sourceColumn: level_id

		column level_name
			dataType: string
			sortByColumn: sort_order
			sourceColumn: level_name

		column level_class
			dataType: string
			sourceColumn: level_class

		column is_headline
			dataType: boolean
			sourceColumn: is_headline

		column sort_order
			dataType: int64
			summarizeBy: none
			isHidden
			sourceColumn: sort_order

		column definition
			dataType: string
			sourceColumn: definition

		partition DimLevel = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "DimLevel.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"level_id", type text}, {"level_name", type text}, {"level_class", type text}, {"is_headline", type logical}, {"sort_order", Int64.Type}, {"definition", type text}}, "en-US")
					in
						Typed

	/// Steps of the L0 -> L1 -> L2 waterfall (disconnected; values come from measures).
	table DimLevelStep

		column lstep_id
			dataType: string
			sourceColumn: lstep_id

		column lstep_name
			dataType: string
			sortByColumn: lstep_order
			sourceColumn: lstep_name

		column lstep_order
			dataType: int64
			summarizeBy: none
			sourceColumn: lstep_order

		partition DimLevelStep = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "DimLevelStep.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"lstep_id", type text}, {"lstep_name", type text}, {"lstep_order", Int64.Type}}, "en-US")
					in
						Typed

	/// Steps of the automotive revenue waterfall (disconnected; values from measures).
	table DimRevenueStep

		column rstep_id
			dataType: string
			sourceColumn: rstep_id

		column rstep_name
			dataType: string
			sortByColumn: rstep_order
			sourceColumn: rstep_name

		column rstep_order
			dataType: int64
			summarizeBy: none
			sourceColumn: rstep_order

		partition DimRevenueStep = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "DimRevenueStep.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"rstep_id", type text}, {"rstep_name", type text}, {"rstep_order", Int64.Type}}, "en-US")
					in
						Typed

	/// Components of the SQL year-on-year EBIT bridge (mart.v_ebit_bridge_yoy).
	table DimBridgeStep

		column step_id
			dataType: string
			sourceColumn: step_id

		column step_name
			dataType: string
			sortByColumn: step_order
			sourceColumn: step_name

		column step_order
			dataType: int64
			summarizeBy: none
			sourceColumn: step_order

		column step_group
			dataType: string
			sourceColumn: step_group

		column sign_note
			dataType: string
			sourceColumn: sign_note

		partition DimBridgeStep = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents(DataFolder & "DimBridgeStep.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"step_id", type text}, {"step_name", type text}, {"step_order", Int64.Type}, {"step_group", type text}, {"sign_note", type text}}, "en-US")
					in
						Typed

	/// One row per half-year: base values from mart.v_panel_hy plus SQL decompositions (v_ebit_adjusted, v_rd_capitalisation, v_da_clean, v_asp_volume, v_cash_crosscheck). Use measures, not columns.
	table FactHalfYear

		/// Group sales revenue, EUR m (G01, S025).
		measure Revenue = SUM ( FactHalfYear[grp_revenue] )
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// L0 reported group operating profit, EUR m (G07, S025).
		measure 'EBIT L0 Reported' = SUM ( FactHalfYear[grp_ebit] )
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// Strategic realignment incl. battery activities, net charge added back (X01; A-01 = 0 where not disclosed).
		measure 'Adj Realignment Battery' = SUM ( FactHalfYear[adj_realignment_net] )
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// US import tariff charge added back (X03; A-02 = 0 before April 2025).
		measure 'Adj US Tariffs' = SUM ( FactHalfYear[adj_us_tariffs] )
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// Total disclosed items added back from L0 to L2.
		measure 'Exceptional Items Added Back' = [Adj Realignment Battery] + [Adj US Tariffs]
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// L1 = L0 + X01. Main underlying (headline adjusted) level.
		measure 'EBIT L1' = [EBIT L0 Reported] + [Adj Realignment Battery]
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// L2 = L1 + X03 (also excl. US tariffs). Headline adjusted level.
		measure 'EBIT L2' = [EBIT L1] + [Adj US Tariffs]
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// Reported return on sales.
		measure 'Margin L0' = DIVIDE ( [EBIT L0 Reported], [Revenue] )
			formatString: 0.0%
			displayFolder: 01 Revenue & EBIT levels

		/// Margin excl. realignment & battery (headline adjusted).
		measure 'Margin L1' = DIVIDE ( [EBIT L1], [Revenue] )
			formatString: 0.0%
			displayFolder: 01 Revenue & EBIT levels

		/// Margin also excl. US tariffs (headline adjusted).
		measure 'Margin L2' = DIVIDE ( [EBIT L2], [Revenue] )
			formatString: 0.0%
			displayFolder: 01 Revenue & EBIT levels

		/// How much the disclosed one-offs depress the reported margin, in margin points.
		measure 'Margin L1 minus L0 (pp)' = ( [Margin L1] - [Margin L0] ) * 100
			formatString: +0.00;-0.00;0.00
			displayFolder: 01 Revenue & EBIT levels

		/// +/- uncertainty of the added-back items: EUR 50m per item rounded to 0.1bn, doubled for derived H2 (A-09).
		measure 'Adjustment Rounding Band' = SUM ( FactHalfYear[rounding_band_eur_m] )
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// Value per step of the L0 -> L1 -> L2 waterfall (use with DimLevelStep[lstep_name]; waterfall total = L2).
		measure 'Level Bridge Value' =
				SWITCH (
					SELECTEDVALUE ( DimLevelStep[lstep_id] ),
					"LB0", [EBIT L0 Reported],
					"LB1", [Adj Realignment Battery],
					"LB2", [Adj US Tariffs]
				)
			formatString: #,##0
			displayFolder: 01 Revenue & EBIT levels

		/// Automotive D&A excluding disclosed impairments (A12 - X05; A-03, A-04).
		measure 'Clean DA' = SUM ( FactHalfYear[da_total] ) - SUM ( FactHalfYear[impairment_used] )
			formatString: #,##0
			displayFolder: 02 L3 supplementary sensitivity

		/// Automotive capitalised development costs (A06).
		measure 'Capitalised Dev Costs' = SUM ( FactHalfYear[rd_capitalised] )
			formatString: #,##0
			displayFolder: 02 L3 supplementary sensitivity

		/// SUPPLEMENTARY HYBRID SENSITIVITY: L1 + clean automotive D&A - automotive capitalised development costs. Not underlying profitability; never headline.
		measure 'EBIT L3 Hybrid Sensitivity' = [EBIT L1] + [Clean DA] - [Capitalised Dev Costs]
			formatString: #,##0
			displayFolder: 02 L3 supplementary sensitivity

		/// SUPPLEMENTARY HYBRID SENSITIVITY margin. Not a KPI.
		measure 'Margin L3 Hybrid Sensitivity' = DIVIDE ( [EBIT L3 Hybrid Sensitivity], [Revenue] )
			formatString: 0.0%
			displayFolder: 02 L3 supplementary sensitivity

		/// L3 if the H1 2026 impairments are NOT inside D&A (assumption A-04 false).
		measure 'EBIT L3 Hybrid Sensitivity alt A-04' = CALCULATE ( SUM ( FactSensitivity[value_eur_m] ), FactSensitivity[sensitivity_id] = "SENS_A04_L3" )
			formatString: #,##0
			displayFolder: 02 L3 supplementary sensitivity

		/// Fixed warning text for every L3 visual.
		measure 'L3 Warning' = "L3 = SUPPLEMENTARY HYBRID SENSITIVITY: group EBIT mixed with automotive-only D&A and R&D. Not underlying profitability - not a KPI."
			displayFolder: 02 L3 supplementary sensitivity

		/// Same half of the prior year; blank when outside the analysis window.
		measure 'Prior Period Code' = SELECTEDVALUE ( DimPeriod[prior_same_half_code] )
			displayFolder: 03 Prior year (same half)

		/// [Revenue] in the same half of the prior year.
		measure 'Revenue PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Revenue], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [EBIT L0 Reported] in the same half of the prior year.
		measure 'EBIT L0 PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [EBIT L0 Reported], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [EBIT L1] in the same half of the prior year.
		measure 'EBIT L1 PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [EBIT L1], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [EBIT L2] in the same half of the prior year.
		measure 'EBIT L2 PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [EBIT L2], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [Margin L0] in the same half of the prior year.
		measure 'Margin L0 PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Margin L0], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: 0.0%
			displayFolder: 03 Prior year (same half)

		/// [Margin L1] in the same half of the prior year.
		measure 'Margin L1 PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Margin L1], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: 0.0%
			displayFolder: 03 Prior year (same half)

		/// [Margin L2] in the same half of the prior year.
		measure 'Margin L2 PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Margin L2], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: 0.0%
			displayFolder: 03 Prior year (same half)

		/// [Adj Realignment Battery] in the same half of the prior year.
		measure 'Adj Realignment PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Adj Realignment Battery], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [Adj US Tariffs] in the same half of the prior year.
		measure 'Adj Tariffs PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Adj US Tariffs], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [Capitalised Dev Costs] in the same half of the prior year.
		measure 'Capitalised Dev Costs PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Capitalised Dev Costs], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [Clean DA] in the same half of the prior year.
		measure 'Clean DA PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Clean DA], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [FS EBIT] in the same half of the prior year.
		measure 'FS EBIT PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [FS EBIT], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [RD PL Charge] in the same half of the prior year.
		measure 'RD PL Charge PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [RD PL Charge], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [Cap Rate Calc] in the same half of the prior year.
		measure 'Cap Rate Calc PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Cap Rate Calc], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: 0.0%
			displayFolder: 03 Prior year (same half)

		/// [Auto Revenue] in the same half of the prior year.
		measure 'Auto Revenue PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Auto Revenue], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [Vehicle Sales] in the same half of the prior year.
		measure 'Vehicle Sales PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Vehicle Sales], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [ASP (EUR k)] in the same half of the prior year.
		measure 'ASP PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [ASP (EUR k)], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0.0
			displayFolder: 03 Prior year (same half)

		/// [Auto NCF] in the same half of the prior year.
		measure 'Auto NCF PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [Auto NCF], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: #,##0
			displayFolder: 03 Prior year (same half)

		/// [NCF Margin] in the same half of the prior year.
		measure 'NCF Margin PY' =
				VAR _p = [Prior Period Code]
				RETURN
					IF ( NOT ISBLANK ( _p ), CALCULATE ( [NCF Margin], REMOVEFILTERS ( DimPeriod ), DimPeriod[period_code] = _p ) )
			formatString: 0.0%
			displayFolder: 03 Prior year (same half)

		/// Group revenue change vs same half prior year.
		measure 'YoY Revenue %' = IF ( NOT ISBLANK ( [Revenue PY] ), DIVIDE ( [Revenue], [Revenue PY] ) - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: 03 Prior year (same half)

		/// Change in reported EBIT, EUR m.
		measure 'YoY EBIT L0' = IF ( NOT ISBLANK ( [EBIT L0 PY] ), [EBIT L0 Reported] - [EBIT L0 PY] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 03 Prior year (same half)

		/// Change in L1 EBIT, EUR m.
		measure 'YoY EBIT L1' = IF ( NOT ISBLANK ( [EBIT L1 PY] ), [EBIT L1] - [EBIT L1 PY] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 03 Prior year (same half)

		/// Change in L2 EBIT, EUR m.
		measure 'YoY EBIT L2' = IF ( NOT ISBLANK ( [EBIT L2 PY] ), [EBIT L2] - [EBIT L2 PY] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 03 Prior year (same half)

		/// Change in reported margin, pp.
		measure 'YoY Margin L0 (pp)' = IF ( NOT ISBLANK ( [Margin L0 PY] ), ( [Margin L0] - [Margin L0 PY] ) * 100 )
			formatString: +0.00;-0.00;0.00
			displayFolder: 03 Prior year (same half)

		/// Change in L1 margin, pp.
		measure 'YoY Margin L1 (pp)' = IF ( NOT ISBLANK ( [Margin L1 PY] ), ( [Margin L1] - [Margin L1 PY] ) * 100 )
			formatString: +0.00;-0.00;0.00
			displayFolder: 03 Prior year (same half)

		/// Change in L2 margin, pp.
		measure 'YoY Margin L2 (pp)' = IF ( NOT ISBLANK ( [Margin L2 PY] ), ( [Margin L2] - [Margin L2 PY] ) * 100 )
			formatString: +0.00;-0.00;0.00
			displayFolder: 03 Prior year (same half)

		/// Change in clean automotive D&A, EUR m.
		measure 'YoY Clean DA' = IF ( NOT ISBLANK ( [Clean DA PY] ), [Clean DA] - [Clean DA PY] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 03 Prior year (same half)

		/// Change in R&D P&L charge, EUR m.
		measure 'YoY RD PL Charge' = IF ( NOT ISBLANK ( [RD PL Charge PY] ), [RD PL Charge] - [RD PL Charge PY] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 03 Prior year (same half)

		/// Change in the capitalisation rate, pp.
		measure 'YoY Cap Rate (pp)' = IF ( NOT ISBLANK ( [Cap Rate Calc PY] ), ( [Cap Rate Calc] - [Cap Rate Calc PY] ) * 100 )
			formatString: +0.00;-0.00;0.00
			displayFolder: 03 Prior year (same half)

		/// Change in automotive revenue, EUR m.
		measure 'YoY Auto Revenue' = IF ( NOT ISBLANK ( [Auto Revenue PY] ), [Auto Revenue] - [Auto Revenue PY] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 03 Prior year (same half)

		/// Change in wholesale vehicle sales.
		measure 'YoY Vehicle Sales %' = IF ( NOT ISBLANK ( [Vehicle Sales PY] ), DIVIDE ( [Vehicle Sales], [Vehicle Sales PY] ) - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: 03 Prior year (same half)

		/// Change in ASP (automotive revenue per vehicle sold).
		measure 'YoY ASP %' = IF ( NOT ISBLANK ( [ASP PY] ), DIVIDE ( [ASP (EUR k)], [ASP PY] ) - 1 )
			formatString: +0.0%;-0.0%;0.0%
			displayFolder: 03 Prior year (same half)

		/// Change in automotive net cash flow margin, pp.
		measure 'YoY NCF Margin (pp)' = IF ( NOT ISBLANK ( [NCF Margin PY] ), ( [NCF Margin] - [NCF Margin PY] ) * 100 )
			formatString: +0.00;-0.00;0.00
			displayFolder: 03 Prior year (same half)

		/// Financial Services operating profit (F02).
		measure 'FS EBIT' = SUM ( FactHalfYear[fs_ebit] )
			formatString: #,##0
			displayFolder: 04 EBIT bridge (SQL)

		/// DAX recomputation of the SQL bridge step (QA).
		measure 'Recompute Eff Exceptional' = IF ( NOT ISBLANK ( [Prior Period Code] ), - ( [Adj Realignment Battery] - [Adj Realignment PY] ) )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// DAX recomputation (QA).
		measure 'Recompute Eff Tariffs' = IF ( NOT ISBLANK ( [Prior Period Code] ), - ( [Adj US Tariffs] - [Adj Tariffs PY] ) )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// DAX recomputation (QA).
		measure 'Recompute Eff Cap Dev' = IF ( NOT ISBLANK ( [Prior Period Code] ), [Capitalised Dev Costs] - [Capitalised Dev Costs PY] )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// DAX recomputation (QA).
		measure 'Recompute Eff Clean DA' = IF ( NOT ISBLANK ( [Prior Period Code] ), - ( [Clean DA] - [Clean DA PY] ) )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// DAX recomputation (QA).
		measure 'Recompute Eff FS' = IF ( NOT ISBLANK ( [Prior Period Code] ), [FS EBIT] - [FS EBIT PY] )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// DAX recomputation of residual / other EBIT drivers (QA).
		measure 'Recompute Residual' = IF ( NOT ISBLANK ( [Prior Period Code] ), [YoY EBIT L0] - [Recompute Eff Exceptional] - [Recompute Eff Tariffs] - [Recompute Eff Cap Dev] - [Recompute Eff Clean DA] - [Recompute Eff FS] )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// Total automotive R&D costs (A05) - Porsche accounting definition, not a cash figure.
		measure 'RD Total Costs' = SUM ( FactHalfYear[rd_total] )
			formatString: #,##0
			displayFolder: 05 R&D & D&A

		/// R&D costs expensed as incurred (A08).
		measure 'RD Expensed' = SUM ( FactHalfYear[rd_expensed] )
			formatString: #,##0
			displayFolder: 05 R&D & D&A

		/// Amortisation of capitalised development costs (A09).
		measure 'Amortisation Cap RD' = SUM ( FactHalfYear[amort_capitalised_rd] )
			formatString: #,##0
			displayFolder: 05 R&D & D&A

		/// R&D charge in the P&L = expensed + amortisation.
		measure 'RD PL Charge' = [RD Expensed] + [Amortisation Cap RD]
			formatString: #,##0
			displayFolder: 05 R&D & D&A

		/// Capitalisation rate = capitalised / total R&D costs.
		measure 'Cap Rate Calc' = DIVIDE ( [Capitalised Dev Costs], [RD Total Costs] )
			formatString: 0.0%
			displayFolder: 05 R&D & D&A

		/// Capitalisation rate as published (A07); H1 periods only.
		measure 'Cap Rate Published' = IF ( HASONEVALUE ( DimPeriod[period_code] ), DIVIDE ( SUM ( FactHalfYear[rd_cap_rate_published] ), 100 ) )
			formatString: 0.0%
			displayFolder: 05 R&D & D&A

		/// >0: the P&L R&D charge is below total R&D costs (capitalisation supports EBIT).
		measure 'Net Capitalisation' = [Capitalised Dev Costs] - [Amortisation Cap RD]
			formatString: #,##0
			displayFolder: 05 R&D & D&A

		/// R&D cost intensity.
		measure 'RD Total % Auto Revenue' = DIVIDE ( [RD Total Costs], [Auto Revenue] )
			formatString: 0.0%
			displayFolder: 05 R&D & D&A

		/// R&D P&L charge intensity.
		measure 'RD PL % Auto Revenue' = DIVIDE ( [RD PL Charge], [Auto Revenue] )
			formatString: 0.0%
			displayFolder: 05 R&D & D&A

		/// SQL: actual R&D P&L charge - charge at prior-year same-half capitalisation rate. >0 = extra charge (EBIT headwind); <0 = EBIT support. Illustrative counterfactual (amortisation held fixed).
		measure 'Cap Rate Effect (SQL)' = SUM ( FactHalfYear[sql_ebit_effect_of_cap_rate_change] )
			formatString: +#,##0.0;-#,##0.0;0.0
			displayFolder: 05 R&D & D&A

		/// DAX recomputation of the capitalisation-rate effect (QA).
		measure 'Cap Rate Effect (DAX recompute)' = IF ( NOT ISBLANK ( [Cap Rate Calc PY] ), [RD PL Charge] - ( [RD Total Costs] * ( 1 - [Cap Rate Calc PY] ) + [Amortisation Cap RD] ) )
			formatString: #,##0.0
			displayFolder: 11 QA recompute

		/// Automotive D&A incl. impairments (A12).
		measure 'DA Total' = SUM ( FactHalfYear[da_total] )
			formatString: #,##0
			displayFolder: 05 R&D & D&A

		/// Disclosed impairments inside automotive D&A as used (X05; A-03 = 0 where undisclosed; A-04 for H1 2026).
		measure 'Impairments in DA' = SUM ( FactHalfYear[impairment_used] )
			formatString: #,##0
			displayFolder: 05 R&D & D&A

		/// FACT / assumption used for impairments in the selected half-year.
		measure 'Impairment Status' = SELECTEDVALUE ( FactHalfYear[impairment_status] )
			displayFolder: 05 R&D & D&A

		/// Clean D&A intensity.
		measure 'Clean DA % Auto Revenue' = DIVIDE ( [Clean DA], [Auto Revenue] )
			formatString: 0.0%
			displayFolder: 05 R&D & D&A

		/// Automotive sales revenue (A01).
		measure 'Auto Revenue' = SUM ( FactHalfYear[auto_revenue] )
			formatString: #,##0
			displayFolder: 06 Commercial

		/// Wholesale vehicle sales (O04) - drives revenue.
		measure 'Vehicle Sales' = SUM ( FactHalfYear[vehicle_sales] )
			formatString: #,##0
			displayFolder: 06 Commercial

		/// Retail deliveries (O01).
		measure 'Retail Deliveries' = SUM ( FactHalfYear[deliveries] )
			formatString: #,##0
			displayFolder: 06 Commercial

		/// Porsche ASP definition: automotive revenue per vehicle sold, EUR k.
		measure 'ASP (EUR k)' = DIVIDE ( [Auto Revenue] * 1000, [Vehicle Sales] )
			formatString: #,##0.0
			displayFolder: 06 Commercial

		/// ASP as published by Porsche (O06), rounded to EUR 1k.
		measure 'ASP Published (EUR k)' = IF ( HASONEVALUE ( DimPeriod[period_code] ), SUM ( FactHalfYear[asp_published_eur_k] ) )
			formatString: #,##0.0
			displayFolder: 06 Commercial

		/// SQL: change in vehicle sales x prior ASP / 1000, EUR m.
		measure 'Volume Effect (SQL)' = SUM ( FactHalfYear[sql_volume_effect] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 06 Commercial

		/// SQL: change in ASP x current vehicle sales / 1000, EUR m. A residual of price, model/derivative mix, options, FX and non-vehicle revenue - not 'price'.
		measure 'ASP Effect (SQL)' = SUM ( FactHalfYear[sql_asp_effect] )
			formatString: +#,##0;-#,##0;0
			displayFolder: 06 Commercial

		/// DAX recomputation (QA).
		measure 'Volume Effect (DAX recompute)' = IF ( NOT ISBLANK ( [Vehicle Sales PY] ), ( [Vehicle Sales] - [Vehicle Sales PY] ) * [ASP PY] / 1000 )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// DAX recomputation (QA).
		measure 'ASP Effect (DAX recompute)' = IF ( NOT ISBLANK ( [ASP PY] ), ( [ASP (EUR k)] - [ASP PY] ) * [Vehicle Sales] / 1000 )
			formatString: #,##0
			displayFolder: 11 QA recompute

		/// QA: volume + ASP effect - revenue change; within 0.1 (SQL rounds each effect to 0.1).
		measure 'Volume ASP Closure Check' = IF ( NOT ISBLANK ( [Auto Revenue PY] ), [Volume Effect (SQL)] + [ASP Effect (SQL)] - [YoY Auto Revenue] )
			formatString: 0.0
			displayFolder: 11 QA recompute

		/// PROXY for channel stock movement (wholesale - retail units).
		measure 'Wholesale minus Retail' = [Vehicle Sales] - [Retail Deliveries]
			formatString: #,##0
			displayFolder: 06 Commercial

		/// BEV share of deliveries as published (O07); H1 periods only.
		measure 'BEV Share Published' = IF ( HASONEVALUE ( DimPeriod[period_code] ), DIVIDE ( SUM ( FactHalfYear[bev_share_published] ), 100 ) )
			formatString: 0.0%
			displayFolder: 06 Commercial

		/// Automotive net cash flow (A13).
		measure 'Auto NCF' = SUM ( FactHalfYear[auto_net_cash_flow] )
			formatString: #,##0
			displayFolder: 07 Cash

		/// Automotive cash flow from operating activities (A13a).
		measure 'Auto CFO' = SUM ( FactHalfYear[auto_cfo] )
			formatString: #,##0
			displayFolder: 07 Cash

		/// Automotive investing activities of current operations (A13b).
		measure 'Auto CFI' = SUM ( FactHalfYear[auto_cfi_operating] )
			formatString: #,##0
			displayFolder: 07 Cash

		/// Automotive EBITDA (A03).
		measure 'Auto EBITDA' = SUM ( FactHalfYear[auto_ebitda] )
			formatString: #,##0
			displayFolder: 07 Cash

		/// Automotive operating profit (A02).
		measure 'Auto EBIT' = SUM ( FactHalfYear[auto_ebit] )
			formatString: #,##0
			displayFolder: 07 Cash

		/// Automotive capex (A10).
		measure 'Auto Capex' = SUM ( FactHalfYear[capex] )
			formatString: #,##0
			displayFolder: 07 Cash

		/// Automotive net cash flow / automotive revenue.
		measure 'NCF Margin' = DIVIDE ( [Auto NCF], [Auto Revenue] )
			formatString: 0.0%
			displayFolder: 07 Cash

		/// Automotive EBITDA margin (calculated).
		measure 'EBITDA Margin' = DIVIDE ( [Auto EBITDA], [Auto Revenue] )
			formatString: 0.0%
			displayFolder: 07 Cash

		/// Automotive EBITDA margin as published (A04); H1 periods only.
		measure 'EBITDA Margin Published' = IF ( HASONEVALUE ( DimPeriod[period_code] ), DIVIDE ( SUM ( FactHalfYear[auto_ebitda_margin_published] ), 100 ) )
			formatString: 0.0%
			displayFolder: 07 Cash

		/// Cash conversion of EBITDA.
		measure 'CFO to EBITDA' = DIVIDE ( [Auto CFO], [Auto EBITDA] )
			formatString: 0.00
			displayFolder: 07 Cash

		/// Net cash flow per euro of automotive EBIT (blank if EBIT <= 0).
		measure 'NCF to EBIT' = IF ( [Auto EBIT] > 0, DIVIDE ( [Auto NCF], [Auto EBIT] ) )
			formatString: 0.00
			displayFolder: 07 Cash

		/// EBITDA - capex - capitalised development costs.
		measure 'Simple Cash Proxy' = [Auto EBITDA] - [Auto Capex] - [Capitalised Dev Costs]
			formatString: #,##0
			displayFolder: 07 Cash

		/// Working capital, tax, provisions and other items (not decomposed).
		measure 'NCF minus Proxy' = [Auto NCF] - [Simple Cash Proxy]
			formatString: #,##0
			displayFolder: 07 Cash

		/// Automotive net liquidity at the end of the latest period in context (stock, not summed).
		measure 'Net Liquidity (period end)' =
				VAR _k = MAX ( DimPeriod[sort_key] )
				RETURN
					CALCULATE ( SUM ( FactHalfYear[auto_net_liquidity] ), REMOVEFILTERS ( DimPeriod ), DimPeriod[sort_key] = _k )
			formatString: #,##0
			displayFolder: 07 Cash

		/// Qualitative cash timing notes from the SQL mart.
		measure 'Cash Notes' = SELECTEDVALUE ( FactHalfYear[cash_notes] )
			displayFolder: 07 Cash

		/// QA: NCF - (CFO + CFI); within 0.5 (AF-12 rounding).
		measure 'NCF Identity Check' = ROUND ( [Auto NCF] - ( [Auto CFO] + [Auto CFI] ), 3 )
			formatString: 0.00
			displayFolder: 11 QA recompute

		/// Label of the latest published half-year.
		measure 'Latest Period Label' = CALCULATE ( SELECTEDVALUE ( DimPeriod[period_label] ), REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			displayFolder: 08 Latest half-year (fixed)

		/// [Revenue] in the latest published half-year, independent of the page slicer.
		measure 'Latest Revenue' = CALCULATE ( [Revenue], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: #,##0
			displayFolder: 08 Latest half-year (fixed)

		/// [EBIT L0 Reported] in the latest published half-year, independent of the page slicer.
		measure 'Latest EBIT L0' = CALCULATE ( [EBIT L0 Reported], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: #,##0
			displayFolder: 08 Latest half-year (fixed)

		/// [Adj Realignment Battery] in the latest published half-year, independent of the page slicer.
		measure 'Latest Adj Realignment' = CALCULATE ( [Adj Realignment Battery], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: #,##0
			displayFolder: 08 Latest half-year (fixed)

		/// [Adj US Tariffs] in the latest published half-year, independent of the page slicer.
		measure 'Latest Adj Tariffs' = CALCULATE ( [Adj US Tariffs], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: #,##0
			displayFolder: 08 Latest half-year (fixed)

		/// [Margin L0] in the latest published half-year, independent of the page slicer.
		measure 'Latest Margin L0' = CALCULATE ( [Margin L0], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: 0.0%
			displayFolder: 08 Latest half-year (fixed)

		/// [Margin L1] in the latest published half-year, independent of the page slicer.
		measure 'Latest Margin L1' = CALCULATE ( [Margin L1], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: 0.0%
			displayFolder: 08 Latest half-year (fixed)

		/// [Margin L2] in the latest published half-year, independent of the page slicer.
		measure 'Latest Margin L2' = CALCULATE ( [Margin L2], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: 0.0%
			displayFolder: 08 Latest half-year (fixed)

		/// [Auto Revenue] in the latest published half-year, independent of the page slicer.
		measure 'Latest Auto Revenue' = CALCULATE ( [Auto Revenue], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: #,##0
			displayFolder: 08 Latest half-year (fixed)

		/// [Auto EBITDA] in the latest published half-year, independent of the page slicer.
		measure 'Latest Auto EBITDA' = CALCULATE ( [Auto EBITDA], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: #,##0
			displayFolder: 08 Latest half-year (fixed)

		/// [Auto NCF] in the latest published half-year, independent of the page slicer.
		measure 'Latest Auto NCF' = CALCULATE ( [Auto NCF], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: #,##0
			displayFolder: 08 Latest half-year (fixed)

		/// [EBITDA Margin] in the latest published half-year, independent of the page slicer.
		measure 'Latest EBITDA Margin' = CALCULATE ( [EBITDA Margin], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: 0.0%
			displayFolder: 08 Latest half-year (fixed)

		/// [NCF Margin] in the latest published half-year, independent of the page slicer.
		measure 'Latest NCF Margin' = CALCULATE ( [NCF Margin], REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
			formatString: 0.0%
			displayFolder: 08 Latest half-year (fixed)

		/// [Margin L0] in H2 of the prior fiscal year (comparator for guidance).
		measure 'Prior H2 Margin L0' =
				VAR _fy = CALCULATE ( MAX ( DimPeriod[fiscal_year] ), REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
				RETURN
					CALCULATE ( [Margin L0], REMOVEFILTERS ( DimPeriod ), DimPeriod[fiscal_year] = _fy - 1, DimPeriod[half_no] = 2 )
			formatString: 0.0%
			displayFolder: 08 Latest half-year (fixed)

		/// [Margin L1] in H2 of the prior fiscal year (comparator for guidance).
		measure 'Prior H2 Margin L1' =
				VAR _fy = CALCULATE ( MAX ( DimPeriod[fiscal_year] ), REMOVEFILTERS ( DimPeriod ), DimPeriod[is_latest] = TRUE () )
				RETURN
					CALCULATE ( [Margin L1], REMOVEFILTERS ( DimPeriod ), DimPeriod[fiscal_year] = _fy - 1, DimPeriod[half_no] = 2 )
			formatString: 0.0%
			displayFolder: 08 Latest half-year (fixed)

		/// Direction of the headline adjusted (L1) margin.
		measure 'Signal Underlying Margin' =
				VAR _d = [YoY Margin L1 (pp)]
				RETURN
					IF ( ISBLANK ( _d ), "No prior-year half in window",
						"L1 margin " & FORMAT ( _d, "+0.0;-0.0" ) & " pp vs same half prior year: " & IF ( _d < 0, "underlying margin DOWN", "underlying margin UP" ) )
			displayFolder: 10 Recovery signals

		/// Is the reported EBIT gain explained by lower disclosed one-offs?
		measure 'Signal Recovery Source' =
				VAR _exc = [Bridge Exceptional] + [Bridge Tariffs]
				VAR _d = [YoY EBIT L0]
				RETURN
					SWITCH ( TRUE (),
						ISBLANK ( _d ), "No prior-year half in window",
						_d > 0 && _exc >= _d, "Lower one-offs (" & FORMAT ( _exc, "+#,##0;-#,##0" ) & " EUR m) exceed the whole reported EBIT gain (" & FORMAT ( _d, "+#,##0;-#,##0" ) & " EUR m)",
						_d > 0, "Lower one-offs explain " & FORMAT ( DIVIDE ( _exc, _d ), "0%" ) & " of the reported EBIT gain",
						"Reported EBIT " & FORMAT ( _d, "+#,##0;-#,##0" ) & " EUR m vs same half prior year" )
			displayFolder: 10 Recovery signals

		/// Sign of the unexplained part of the EBIT change.
		measure 'Signal Other Drivers' =
				VAR _r = [Bridge Residual]
				RETURN
					IF ( ISBLANK ( _r ), "No prior-year half in window",
						"Residual / other EBIT drivers " & FORMAT ( _r, "+#,##0;-#,##0" ) & " EUR m (" & IF ( _r < 0, "negative", "positive" ) & "; not separated - not operating performance)" )
			displayFolder: 10 Recovery signals

		/// Does value (ASP) compensate for lower volume?
		measure 'Signal Value over Volume' =
				VAR _v = [Volume Effect (SQL)]
				VAR _a = [ASP Effect (SQL)]
				RETURN
					SWITCH ( TRUE (),
						ISBLANK ( _v ), "No prior-year half in window",
						_v < 0 && _a > 0, "ASP effect " & FORMAT ( _a, "+#,##0" ) & " offsets " & FORMAT ( DIVIDE ( _a, - _v ), "0%" ) & " of the volume effect " & FORMAT ( _v, "#,##0" ) & " EUR m",
						"Volume effect " & FORMAT ( _v, "+#,##0;-#,##0" ) & ", ASP effect " & FORMAT ( _a, "+#,##0;-#,##0" ) & " EUR m" )
			displayFolder: 10 Recovery signals

		/// Non-cash support or headwind from the capitalisation rate (illustrative counterfactual).
		measure 'Signal Capitalisation' =
				VAR _c = [Cap Rate Effect (SQL)]
				RETURN
					IF ( ISBLANK ( _c ), "No prior-year half in window",
						IF ( _c < 0,
							"Higher capitalisation rate lowered the R&D P&L charge by " & FORMAT ( - _c, "#,##0" ) & " EUR m vs the prior-year rate (non-cash EBIT support)",
							"Lower capitalisation rate added " & FORMAT ( _c, "#,##0" ) & " EUR m to the R&D P&L charge vs the prior-year rate (non-cash EBIT headwind)" ) )
			displayFolder: 10 Recovery signals

		/// Does cash move with profit?
		measure 'Signal Cash' =
				VAR _d = [YoY NCF Margin (pp)]
				RETURN
					IF ( ISBLANK ( _d ), "No prior-year half in window",
						"Automotive NCF margin " & FORMAT ( [NCF Margin], "0.0%" ) & " (" & FORMAT ( _d, "+0.0;-0.0" ) & " pp vs same half prior year)" )
			displayFolder: 10 Recovery signals

		/// Conditional-format colour (red = down, green = up).
		measure 'Signal Color L1' = IF ( [YoY Margin L1 (pp)] < 0, "#B3261E", IF ( [YoY Margin L1 (pp)] > 0, "#1B6E3C", "#5F6368" ) )
			displayFolder: 10 Recovery signals

		/// Conditional-format colour.
		measure 'Signal Color Residual' = IF ( [Bridge Residual] < 0, "#B3261E", IF ( [Bridge Residual] > 0, "#1B6E3C", "#5F6368" ) )
			displayFolder: 10 Recovery signals

		/// EBIT for the level on the legend. L3 appears only where DimLevel[is_headline] is not filtered to TRUE (sensitivity visuals).
		measure 'EBIT by Level' =
				SWITCH ( SELECTEDVALUE ( DimLevel[level_id] ),
					"L0", [EBIT L0 Reported],
					"L1", [EBIT L1],
					"L2", [EBIT L2],
					"L3", [EBIT L3 Hybrid Sensitivity] )
			formatString: #,##0
			displayFolder: 13 Level-driven (legend = DimLevel)

		/// Margin for the level on the legend.
		measure 'Margin by Level' =
				SWITCH ( SELECTEDVALUE ( DimLevel[level_id] ),
					"L0", [Margin L0],
					"L1", [Margin L1],
					"L2", [Margin L2],
					"L3", [Margin L3 Hybrid Sensitivity] )
			formatString: 0.0%
			displayFolder: 13 Level-driven (legend = DimLevel)

		/// Latest actual half-year margin for the level on the axis (comparator on the guidance chart).
		measure 'Latest Margin by Level' =
				SWITCH ( SELECTEDVALUE ( DimLevel[level_id] ),
					"L0", [Latest Margin L0],
					"L1", [Latest Margin L1],
					"L2", [Latest Margin L2] )
			formatString: 0.0%
			displayFolder: 13 Level-driven (legend = DimLevel)

		/// Automotive revenue waterfall: prior-year revenue, volume effect, ASP effect (total = current automotive revenue within SQL 0.1 rounding).
		measure 'Revenue Bridge Value' =
				SWITCH ( SELECTEDVALUE ( DimRevenueStep[rstep_id] ),
					"RS0", [Auto Revenue PY],
					"RS1", [Volume Effect (SQL)],
					"RS2", [ASP Effect (SQL)] )
			formatString: #,##0
			displayFolder: 06 Commercial

		column period_code
			dataType: string
			sourceColumn: period_code

		column grp_revenue
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: grp_revenue

		column grp_ebit
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: grp_ebit

		column adj_realignment_net
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: adj_realignment_net

		column adj_us_tariffs
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: adj_us_tariffs

		column rounding_band_eur_m
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: rounding_band_eur_m

		column ebit_assumptions_used
			dataType: string
			sourceColumn: ebit_assumptions_used

		column exc_battery_memo
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: exc_battery_memo

		column auto_revenue
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: auto_revenue

		column auto_ebit
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: auto_ebit

		column auto_ebitda
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: auto_ebitda

		column auto_ebitda_margin_published
			dataType: double
			summarizeBy: none
			isHidden
			formatString: 0.00
			sourceColumn: auto_ebitda_margin_published

		column rd_total
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: rd_total

		column rd_capitalised
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: rd_capitalised

		column rd_expensed
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: rd_expensed

		column amort_capitalised_rd
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: amort_capitalised_rd

		column rd_cap_rate_published
			dataType: double
			summarizeBy: none
			isHidden
			formatString: 0.00
			sourceColumn: rd_cap_rate_published

		column sql_ebit_effect_of_cap_rate_change
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: sql_ebit_effect_of_cap_rate_change

		column sql_rd_pl_at_prior_cap_rate
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: sql_rd_pl_at_prior_cap_rate

		column capex
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: capex

		column dep_on_capex
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: dep_on_capex

		column da_total
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: da_total

		column impairment_used
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: impairment_used

		column impairment_status
			dataType: string
			sourceColumn: impairment_status

		column fs_revenue
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: fs_revenue

		column fs_ebit
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: fs_ebit

		column auto_cfo
			dataType: double
			summarizeBy: none
			isHidden
			formatString: #,##0.00
			sourceColumn: auto_cfo

		column auto_cfi_operating
			dataType: double
			summarizeBy: none
			isHidden
