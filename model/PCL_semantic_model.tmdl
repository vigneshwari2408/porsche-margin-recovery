						Typed = Table.TransformColumnTypes(Promoted, {{"scenario_id", type text}, {"scenario_type", type text}, {"case_rev", type text}, {"case_m", type text}, {"fy_grp_rev", type number}, {"auto_share_pct_assumed", type number}, {"fy_auto_rev", type number}, {"h2_auto_rev", type number}, {"fy_ebitda_margin", type number}, {"h2_auto_ebitda_margin_pct", type number}, {"fy_ncf_margin", type number}, {"h2_auto_ncf_margin_pct", type number}, {"h1_2026_auto_ebitda_margin_pct", type number}, {"h1_2026_auto_ncf_margin_pct", type number}, {"assumptions_used", type text}}, "en-US")
