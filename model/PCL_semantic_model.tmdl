	/// mart.v_guidance_2026_auto: 9 automotive SCENARIO COMBINATIONS (revenue end x margin end). NOT forecasts.
	table FactGuidanceAuto

		/// H2 2026 automotive margin implied by the selected revenue end (group slicer) and margin end (automotive slicer). Uses A-05. Not a forecast.
		measure 'Scen Auto H2 EBITDA Margin' =
				VAR _t = CALCULATETABLE ( FactGuidanceAuto, TREATAS ( VALUES ( FactGuidance[case_rev] ), FactGuidanceAuto[case_rev] ) )
				RETURN
					IF ( COUNTROWS ( _t ) = 1, SUMX ( _t, FactGuidanceAuto[h2_auto_ebitda_margin_pct] ) / 100 )
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Lowest across the 9 automotive combinations.
		measure 'Scen Auto Min EBITDA Margin' = CALCULATE ( MIN ( FactGuidanceAuto[h2_auto_ebitda_margin_pct] ), REMOVEFILTERS ( FactGuidanceAuto ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// All-midpoints automotive combination.
		measure 'Scen Auto Mid EBITDA Margin' = CALCULATE ( SUM ( FactGuidanceAuto[h2_auto_ebitda_margin_pct] ), REMOVEFILTERS ( FactGuidanceAuto ), FactGuidanceAuto[scenario_id] = "mid/mid" ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Highest across the 9 automotive combinations.
		measure 'Scen Auto Max EBITDA Margin' = CALCULATE ( MAX ( FactGuidanceAuto[h2_auto_ebitda_margin_pct] ), REMOVEFILTERS ( FactGuidanceAuto ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// H2 2026 automotive margin implied by the selected revenue end (group slicer) and margin end (automotive slicer). Uses A-05. Not a forecast.
		measure 'Scen Auto H2 NCF Margin' =
				VAR _t = CALCULATETABLE ( FactGuidanceAuto, TREATAS ( VALUES ( FactGuidance[case_rev] ), FactGuidanceAuto[case_rev] ) )
				RETURN
					IF ( COUNTROWS ( _t ) = 1, SUMX ( _t, FactGuidanceAuto[h2_auto_ncf_margin_pct] ) / 100 )
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Lowest across the 9 automotive combinations.
		measure 'Scen Auto Min NCF Margin' = CALCULATE ( MIN ( FactGuidanceAuto[h2_auto_ncf_margin_pct] ), REMOVEFILTERS ( FactGuidanceAuto ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// All-midpoints automotive combination.
		measure 'Scen Auto Mid NCF Margin' = CALCULATE ( SUM ( FactGuidanceAuto[h2_auto_ncf_margin_pct] ), REMOVEFILTERS ( FactGuidanceAuto ), FactGuidanceAuto[scenario_id] = "mid/mid" ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// Highest across the 9 automotive combinations.
		measure 'Scen Auto Max NCF Margin' = CALCULATE ( MAX ( FactGuidanceAuto[h2_auto_ncf_margin_pct] ), REMOVEFILTERS ( FactGuidanceAuto ) ) / 100
			formatString: 0.00%
			displayFolder: 09 Guidance scenarios (NOT forecasts)

		/// DAX recomputation with A-05 (automotive share of H1 2026) (QA).
		measure 'Scen Auto H2 EBITDA Margin (DAX recompute)' =
				VAR _share = DIVIDE ( [Latest Auto Revenue], [Latest Revenue] )
				VAR _fyauto = SELECTEDVALUE ( FactGuidanceAuto[fy_grp_rev] ) * _share
				RETURN
					IF ( COUNTROWS ( FactGuidanceAuto ) = 1, DIVIDE ( SELECTEDVALUE ( FactGuidanceAuto[fy_ebitda_margin] ) / 100 * _fyauto - [Latest Auto EBITDA], _fyauto - [Latest Auto Revenue] ) )
			formatString: 0.00%
			displayFolder: 11 QA recompute

		/// DAX recomputation with A-05 (automotive share of H1 2026) (QA).
		measure 'Scen Auto H2 NCF Margin (DAX recompute)' =
				VAR _share = DIVIDE ( [Latest Auto Revenue], [Latest Revenue] )
				VAR _fyauto = SELECTEDVALUE ( FactGuidanceAuto[fy_grp_rev] ) * _share
				RETURN
					IF ( COUNTROWS ( FactGuidanceAuto ) = 1, DIVIDE ( SELECTEDVALUE ( FactGuidanceAuto[fy_ncf_margin] ) / 100 * _fyauto - [Latest Auto NCF], _fyauto - [Latest Auto Revenue] ) )
			formatString: 0.00%
			displayFolder: 11 QA recompute

		column scenario_id
			dataType: string
			sourceColumn: scenario_id

		column scenario_type
